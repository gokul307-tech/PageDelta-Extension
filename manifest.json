{
    "manifest_version": 3,
    "name": "PageDelta",
    "version": "1.0.0",
    "description": "An intelligent browser extension that analyzes webpages, detects important information, tracks changes, and helps users manage actions and deadlines.",

    "permissions": [
        "storage",
        "tabs",
        "notifications",
        "alarms"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "background/background.js"
    },

    "action": {
        "default_title": "PageDelta",
        "default_popup": "popup/popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "utils/constants.js",
                "utils/stringUtils.js",
                "utils/dateUtils.js",
                "utils/urlUtils.js",
                "utils/sanitize.js",
                "utils/domUtils.js",

                "analyzer/textExtractor.js",
                "analyzer/metadataExtractor.js",
                "analyzer/dateDetector.js",
                "analyzer/deadlineDetector.js",
                "analyzer/priceDetector.js",
                "analyzer/requirementDetector.js",
                "analyzer/actionDetector.js",
                "analyzer/contactDetector.js",
                "analyzer/keywordEngine.js",
                "analyzer/importanceScorer.js",
                "analyzer/pageAnalyzer.js",

                "intelligence/fieldClassifier.js",
                "intelligence/contextAnalyzer.js",
                "intelligence/actionMapper.js",
                "intelligence/informationRanker.js",
                "intelligence/confidenceEngine.js",
                "intelligence/languageDetector.js",

                "delta/snapshotNormalizer.js",
                "delta/textDiff.js",
                "delta/elementDiff.js",
                "delta/changeImportance.js",
                "delta/changeDetector.js",
                "delta/snapshotManager.js",

                "content/floatingPanel.js",
                "content/pageObserver.js",
                "content/content.js"
            ],
            "css": [
                "content/content.css",
                "content/floatingPanel.css"
            ],
            "run_at": "document_idle"
        }
    ],

    "web_accessible_resources": [
        {
            "resources": [
                "assets/icons/*",
                "assets/images/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],

    "options_page": "settings/settings.html"
}